# Kakao Maps JavaScript key
# https://developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키
# 앱 설정 > 플랫폼 > Web 에 http://localhost:5173 등록 필요
VITE_KAKAO_MAP_KEY=

# Kakao Local REST API key (장소검색 / 좌표->주소 변환)
# https://developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키
# 위 카카오맵 키와 같은 앱이면 별도 활성화 없이 바로 동작함
VITE_KAKAO_REST_KEY=

# (선택) 백엔드 주소. 비워두면 같은 서버(/api)를 쓴다 — 스프링 static 배포(B안)와
# npm run dev(vite.config.js의 /api 프록시 → localhost:8080)는 비워둔 채로 동작.
# VITE_API_BASE_URL=http://localhost:8080

# 백엔드(Spring) 연결: true면 로그인·회원가입·보호자 연락처·즐겨찾기를 /api 로 호출한다.
# 비워두면(기본) 브라우저 저장소 mock으로 동작 — Vercel 시연 배포가 이 모드.
# 로컬에서 Spring(8080)을 켜고 npm run dev 할 때는 .env.local 에 true 로 넣는다(vite 프록시가 /api → 8080).
# npm run build:spring 은 vite.config.js에서 자동으로 true.
# VITE_USE_BACKEND=true

# 생활안전지도 > 인증키 발급 + 범죄주의구간(전체) 활용 신청
# 카카오 키와 다른 키입니다. 서버 전용: VITE_ 접두사를 붙이지 마세요.
# 원본 키 또는 URL 인코딩된 키 모두 입력 가능. 변경 후 npm run dev 재시작.
SAFEMAP_SERVICE_KEY=
