# Kakao Maps JavaScript key
# https://developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키
# 앱 설정 > 플랫폼 > Web 에 http://localhost:5173 등록 필요
VITE_KAKAO_MAP_KEY=

# Kakao Local REST API key (장소검색 / 좌표->주소 변환)
# https://developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키
# 위 카카오맵 키와 같은 앱이면 별도 활성화 없이 바로 동작함
VITE_KAKAO_REST_KEY=
